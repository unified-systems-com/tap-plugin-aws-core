{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tap:aws_core:collector:resource-manifest:v0",
  "title": "AWS Core Collector Resource Manifest v0",
  "description": "Schema for the manifest that drives the boto3 collector engine. See plugins/aws_core/specs/spec-aws-core-collector-v0.md (req-aws-collector-manifest). The engine validates a manifest against this schema at load; an invalid manifest fails the run visibly.",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifest_version", "entries"],
  "properties": {
    "manifest_version": { "type": "string", "minLength": 1 },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/entry" }
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entity_type",
        "service",
        "scope",
        "source",
        "why",
        "items_path",
        "natural_key",
        "fields",
        "sensitivity"
      ],
      "properties": {
        "entity_type": { "type": "string", "minLength": 1 },
        "service": { "type": "string", "minLength": 1 },
        "scope": { "type": "string", "enum": ["regional", "global"] },
        "source": { "$ref": "#/$defs/source" },
        "why": { "type": "string", "minLength": 1 },
        "items_path": { "type": "string", "minLength": 1 },
        "natural_key": { "type": "string", "minLength": 1 },
        "fields": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "type": "string", "minLength": 1 }
        },
        "hydrate": {
          "type": "array",
          "items": { "$ref": "#/$defs/hydrate_op" }
        },
        "tags": { "$ref": "#/$defs/tags_block" },
        "edges": {
          "type": "array",
          "items": { "$ref": "#/$defs/edge_rule" }
        },
        "sensitivity": { "$ref": "#/$defs/sensitivity" }
      }
    },
    "source": {
      "type": "object",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["aws_op"],
          "properties": { "aws_op": { "type": "string", "minLength": 1 } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["custom_fn"],
          "properties": { "custom_fn": { "type": "string", "minLength": 1 } }
        }
      ]
    },
    "hydrate_op": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "op", "why"],
      "properties": {
        "key": { "type": "string", "minLength": 1 },
        "op": { "type": "string", "minLength": 1 },
        "why": { "type": "string", "minLength": 1 }
      }
    },
    "tags_block": {
      "type": "object",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["source", "from", "shape"],
          "properties": {
            "source": { "const": "field" },
            "from": { "type": "string", "minLength": 1 },
            "shape": { "type": "string", "enum": ["list_kv", "map"] },
            "why": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["source", "resource_type_filter"],
          "properties": {
            "source": { "const": "rgta" },
            "resource_type_filter": { "type": "string", "minLength": 1 },
            "arn_from": { "type": "string", "minLength": 1 },
            "why": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["source", "op", "params", "path", "shape"],
          "properties": {
            "source": { "const": "service" },
            "op": { "type": "string", "minLength": 1 },
            "params": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": {
                "type": "object",
                "oneOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["literal"],
                    "properties": { "literal": { "type": "string" } }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["from"],
                    "properties": { "from": { "type": "string", "minLength": 1 } }
                  }
                ]
              }
            },
            "path": { "type": "string", "minLength": 1 },
            "shape": { "type": "string", "enum": ["list_kv", "map"] },
            "why": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "edge_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value_path", "target_type", "key_kind", "edge_type", "direction"],
      "properties": {
        "value_path": { "type": "string", "minLength": 1 },
        "target_type": { "type": "string", "minLength": 1 },
        "key_kind": { "type": "string", "enum": ["arn", "id", "name"] },
        "edge_type": { "type": "string", "minLength": 1 },
        "direction": { "type": "string", "enum": ["outbound", "inbound"] },
        "transform": { "type": "string", "minLength": 1 }
      }
    },
    "sensitivity": {
      "description": "Whether this entry's raw AWS response (the item the source yields, which becomes the node's configuration envelope) may carry sensitive values, and where. Required on every entry. Three states, and absence is none of them: an entry without this block fails schema validation, so 'nobody has looked' can never read as 'safe'. Recorded under the 2026-09-23 ruling that disabled raw-response persistence (req-aws-core-fields-1): each location listed here must be dealt with before PERSIST_RAW_CONFIGURATION is turned back on. Masking is not the remedy; the raw response is audit evidence.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "description": "unreviewed: nobody has checked this response shape yet (the default for a new entry; says nothing about safety). reviewed_none_known: the response shape was checked and no location is known to carry sensitive values. reviewed_may_contain: the shape was checked and the listed locations may carry sensitive values.",
          "type": "string",
          "enum": [
            "unreviewed",
            "reviewed_none_known",
            "reviewed_may_contain"
          ]
        },
        "basis": {
          "description": "One line naming the method behind the status: what was read (for example which botocore output shapes and which custom_fn) and when. Required for both reviewed states; for unreviewed, optionally why it is not yet reviewed.",
          "type": "string",
          "minLength": 1
        },
        "locations": {
          "description": "The response locations that may carry sensitive values. Present and non-empty exactly when status is reviewed_may_contain.",
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/sensitive_location"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "reviewed_may_contain"
              }
            }
          },
          "then": {
            "required": [
              "basis",
              "locations"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "reviewed_none_known"
              }
            }
          },
          "then": {
            "required": [
              "basis"
            ],
            "not": {
              "required": [
                "locations"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "unreviewed"
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "locations"
              ]
            }
          }
        }
      ]
    },
    "sensitive_location": {
      "description": "One place in the raw response that may carry a sensitive value.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "category",
        "reason",
        "evidence"
      ],
      "properties": {
        "path": {
          "description": "Location in the manifest's own path dialect (paths.py: dotted keys, [] to flatten a list), resolved against the item the source yields, which is the root of the node's configuration envelope. A path ending at a map or object covers its whole subtree.",
          "type": "string",
          "minLength": 1
        },
        "category": {
          "description": "credential: secret material that grants access if disclosed (keys, tokens, shared-secret headers, external ids). personal_data: data identifying a natural person (email addresses, human user or session names). customer_content: operator-authored payloads whose structure AWS does not constrain (environment variables, templates, patterns) and which may embed any other category. access_policy: resource or trust policy documents; not secret, but a map of who can reach what. free_text: operator-authored descriptions and comments. diagnostic: service-composed error or status messages that may echo sensitive input. other: none of these; the reason must say why it is listed.",
          "type": "string",
          "enum": [
            "credential",
            "personal_data",
            "customer_content",
            "access_policy",
            "free_text",
            "diagnostic",
            "other"
          ]
        },
        "reason": {
          "description": "One line saying what sensitive value could appear here.",
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "description": "How this location was identified. botocore_sensitive: the botocore service model marks the member with the sensitive trait. reviewer_judgement: a reviewer read the output shape (or the custom_fn that builds the item) and judged it.",
          "type": "string",
          "enum": [
            "botocore_sensitive",
            "reviewer_judgement"
          ]
        }
      }
    }
  }
}
